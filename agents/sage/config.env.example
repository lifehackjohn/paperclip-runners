# Sage Runner — environment configuration
# Copy to .env (or export vars) before running.

# ── Paperclip ──────────────────────────────────────────────────────────────────
PAPERCLIP_API_URL=http://localhost:3100
SAGE_PAPERCLIP_API_KEY=your_sage_paperclip_api_key_here

# ── LLM: oMLX ──────────────────────────────────────────────────────────────────
# Sage runs exclusively on oMLX — no cloud inference, no data leaves the Mac Mini.
OMLX_URL=http://localhost:8000/v1
OMLX_MODEL=Qwen3.5-9B-mlx-lm-mxfp4
OMLX_API_KEY=your_omlx_api_key_here

# ── Memory: mem0 (dual namespace) ─────────────────────────────────────────────
MEM0_URL=http://localhost:8050

# Shared institutional knowledge namespace (BIE engagements, methodologies).
# Sage reads and writes here alongside the broader team.
MEM0_INSTITUTIONAL_USER_ID=johannes

# Sage's private operational namespace (task context, conversation history).
# Only Sage reads and writes here.
MEM0_OPERATIONAL_USER_ID=sage

# ── LifeOS vault ──────────────────────────────────────────────────────────────
# Sage's working directory — all vault operations target this path.
LIFEOS_VAULT_PATH=/Volumes/Public/apps/LifeOS

# ── Runner port ────────────────────────────────────────────────────────────────
SAGE_RUNNER_PORT=6127
