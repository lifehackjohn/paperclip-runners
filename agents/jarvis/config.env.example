# Jarvis Runner — environment configuration
# Copy to .env (or export vars) before running.

# ── Paperclip ─────────────────────────────────────────────────────────────────
PAPERCLIP_API_URL=http://localhost:3100
JARVIS_PAPERCLIP_API_KEY=your_jarvis_paperclip_api_key_here

# ── LLM: oMLX ─────────────────────────────────────────────────────────────────
# oMLX is the local MLX inference engine. Get the API key from Mission Control.
OMLX_URL=http://localhost:8000/v1
OMLX_MODEL=Qwen3.5-9B-mlx-lm-mxfp4
OMLX_API_KEY=your_omlx_api_key_here

# ── Memory: mem0 ──────────────────────────────────────────────────────────────
MEM0_URL=http://localhost:8050
MEM0_USER_ID=jarvis

# ── WhatsApp bridge ────────────────────────────────────────────────────────────
# Path to the Baileys bridge.js (reuses the existing Hermes bridge).
WHATSAPP_BRIDGE_SCRIPT=/Users/hermes/.hermes/hermes-agent/scripts/whatsapp-bridge/bridge.js

# Port the bridge HTTP server listens on (must not conflict with other bridges).
# Default Hermes bridge uses 3000 — Jarvis uses 3001.
WHATSAPP_BRIDGE_PORT=3001

# WhatsApp session storage (separate from Hermes sessions to avoid conflicts).
# A fresh QR code pair is required the first time.
WHATSAPP_SESSION_DIR=/Users/hermes/.paperclip/runners/jarvis/whatsapp-session

# "self-chat" = Jarvis uses the same WhatsApp number as Johannes (replies appear
#               as your own messages to yourself in a self-chat / Saved Messages).
# "bot"       = Jarvis uses a dedicated WhatsApp number (registered as a device).
WHATSAPP_MODE=self-chat

# Reply prefix shown before each Jarvis response in self-chat mode.
# Set to empty string to disable.
WHATSAPP_REPLY_PREFIX=

# ── Runner port ────────────────────────────────────────────────────────────────
JARVIS_RUNNER_PORT=6126
