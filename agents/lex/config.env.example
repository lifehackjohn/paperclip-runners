# Lex Runner — environment configuration
# Copy to .env and fill in your values, or export these before running.

# Paperclip connection
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=your_paperclip_api_key_here

# LLM endpoint (Ollama or OpenAI-compatible, e.g. oMLX / LM Studio)
OLLAMA_URL=http://localhost:8000/v1     # oMLX example; use http://localhost:11434 for native Ollama
OLLAMA_MODEL=Qwen3.5-9B-mlx-lm-mxfp4  # replace with any model available on your server
OLLAMA_API_KEY=                         # leave blank for Ollama; required for oMLX if auth is on

# Mem0 memory (optional — comment out / leave blank to disable)
MEM0_URL=http://localhost:8050
MEM0_USER_ID=lex                        # namespace for this agent's memories

# HTTP port this runner listens on
RUNNER_PORT=6124
